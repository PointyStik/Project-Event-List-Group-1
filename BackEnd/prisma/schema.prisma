generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id               String   @id @default(cuid())
  name             String
  description      String
  date             DateTime
  location         String
  locationCategory String?
  registrationLink String   @default("")
  price            String?
  imageUrl         String?
}
